{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(scripts/check-site.sh*)",
      "Bash(python3 -m http.server*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/check-site.sh --hook 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking site content"
          }
        ]
      }
    ]
  }
}
